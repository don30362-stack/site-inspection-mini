# Allow only source and Docker configuration into the build context.
**
!Dockerfile
!docker/
!docker/*.conf
!docker/*.ini
!docker/*.sh
!backend/
!backend/artisan
!backend/composer.json
!backend/composer.lock
!backend/app/
!backend/app/**
!backend/bootstrap/
!backend/bootstrap/app.php
!backend/bootstrap/providers.php
!backend/config/
!backend/config/**
!backend/database/
!backend/database/migrations/
!backend/database/migrations/**
!backend/routes/
!backend/routes/**
!backend/resources/
!backend/resources/**
!backend/public/
!backend/public/index.php
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/env.d.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
# Parent-directory exceptions must not admit runtime caches or test material.
backend/bootstrap/cache
backend/tests
backend/public/*
!backend/public/index.php
backend/database/*
!backend/database/migrations/
!backend/database/migrations/**
# Defense in depth: templates are runtime documentation, not image inputs.
**/.env*
**/auth.json
**/*.sqlite*
**/*.db*
**/*.sql*
**/*.bak
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/node_modules
**/vendor
**/storage
**/dist
**/.phpunit.cache
**/.phpunit.result.cache
**/coverage
**/*.log
